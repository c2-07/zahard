---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { sql, getSetting } from '../lib/db';
import { verifySession } from '../lib/auth';

const cookie = Astro.cookies.get('session');
if (!cookie) {
  return Astro.redirect('/login');
}
const user = await verifySession(cookie.value);
if (!user) {
  return Astro.redirect('/login');
}

const host = Astro.url.host;
const protocol = Astro.url.protocol;
// If testing locally or via vercel, give correct absolute URL
const installUrl = `${protocol}//${host}/install`;

let apiEnabled = false;
let defaultExp = 1;
let userExpiresAt = null;
let users = [];
let requests = [];
let pendingCount = 0;

if (user?.role === 'admin') {
  apiEnabled = await getSetting('api_enabled') === 'true';
  defaultExp = parseInt(await getSetting('default_expiration_days') || '1');
  
  const { rows: uRows } = await sql`SELECT * FROM users ORDER BY created_at DESC`;
  users = uRows;
  
  const { rows: rRows } = await sql`SELECT * FROM access_requests ORDER BY requested_at DESC`;
  requests = rRows;
  pendingCount = requests.filter((r: any) => r.status === 'pending').length;
} else {
  const { rows } = await sql`SELECT expires_at FROM users WHERE id = ${user?.userId}`;
  userExpiresAt = rows[0]?.expires_at;
}
---
<DashboardLayout title="Dashboard">
  <div class="flex flex-col md:flex-row flex-1 overflow-hidden h-full">
    <!-- Sidebar Navigation -->
    <aside class="md:w-64 border-b md:border-b-0 md:border-r border-[var(--border)] bg-black/40 p-6 shrink-0 flex flex-row md:flex-col gap-2 overflow-x-auto md:overflow-y-auto items-start">
      <button class="tab-btn w-full whitespace-nowrap text-left px-4 py-3 rounded-lg text-sm font-medium transition-all uppercase tracking-wider bg-[var(--border)] text-white" data-target="overview">
        Overview
      </button>
      
      {user.role === 'admin' && (
        <>
          <button class="tab-btn w-full whitespace-nowrap text-left px-4 py-3 rounded-lg text-sm font-medium transition-all uppercase tracking-wider text-white/60 hover:text-white hover:bg-white/5 flex items-center justify-between" data-target="users">
            Users
          </button>
          <button class="tab-btn w-full whitespace-nowrap text-left px-4 py-3 rounded-lg text-sm font-medium transition-all uppercase tracking-wider text-white/60 hover:text-white hover:bg-white/5 flex items-center justify-between" data-target="requests">
            <span>Requests</span>
            {pendingCount > 0 && (
              <span class="bg-blue-500/20 text-blue-400 border border-blue-500/30 rounded px-2 py-0.5 text-[10px] font-mono ml-2">{pendingCount}</span>
            )}
          </button>
          <button class="tab-btn w-full whitespace-nowrap text-left px-4 py-3 rounded-lg text-sm font-medium transition-all uppercase tracking-wider text-white/60 hover:text-white hover:bg-white/5" data-target="settings">
            Settings
          </button>
        </>
      )}
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 p-6 md:p-10 overflow-y-auto relative bg-[var(--background)]">
      
      <!-- OVERVIEW TAB -->
      <section id="overview" class="tab-content block animate-in fade-in duration-500 max-w-4xl">
        <div class="mb-10">
          <h1 class="text-4xl font-bold uppercase tracking-widest mb-2">Welcome, {user.username}</h1>
          <div class="text-sm opacity-60">Your workspace is ready.</div>
        </div>

        {user.role === 'user' && userExpiresAt && (
          <div class="card p-6 border border-yellow-500/20 bg-yellow-500/5 mb-8 flex items-center justify-between">
            <div>
              <h2 class="text-sm font-bold uppercase tracking-wider mb-1 text-yellow-500">Access Status</h2>
              <div class="text-xs opacity-80 uppercase tracking-widest">Active until expiration</div>
            </div>
            <div class="font-mono text-right">
              <div class="text-lg">{new Date(userExpiresAt).toLocaleDateString()}</div>
              <div class="text-xs opacity-60">{new Date(userExpiresAt).toLocaleTimeString()}</div>
            </div>
          </div>
        )}

        <!-- Install Instructions -->
        <div class="card p-8 border border-blue-500/20 bg-blue-500/5 relative overflow-hidden group shadow-lg">
          <div class="absolute inset-0 bg-gradient-to-br from-blue-500/10 to-purple-500/10 opacity-50"></div>
          <h2 class="text-xl font-bold uppercase tracking-wider mb-3 relative flex items-center gap-3">
            <svg class="w-6 h-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M4 15V9a2 2 0 012-2h12a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2z"></path></svg>
            CLI Installation
          </h2>
          <p class="mb-6 text-sm opacity-80 relative leading-relaxed">Your account has been approved. Run the following command in your terminal to securely install the `ass` CLI to your local machine:</p>
          
          <div class="relative bg-black/60 p-4 rounded-lg border border-white/10 flex flex-col md:flex-row md:items-center justify-between gap-4 group-hover:border-white/30 transition-colors shadow-inner">
            <code class="text-green-400 font-mono text-sm break-all select-all">curl -fsSL {installUrl} | bash</code>
          </div>
          
          <div class="mt-6 text-sm opacity-80 relative bg-black/30 p-5 rounded-lg border border-white/5">
            <div class="font-bold uppercase tracking-widest text-xs mb-3 opacity-60">Getting Started:</div>
            <ol class="list-decimal list-inside space-y-3 ml-1 text-white/90">
              <li>Log in to your account: <code class="text-blue-400 bg-blue-400/10 px-1.5 py-0.5 rounded font-mono text-xs ml-1">ass login</code></li>
              <li>Ask a question: <code class="text-blue-400 bg-blue-400/10 px-1.5 py-0.5 rounded font-mono text-xs ml-1">ass "Hello world!"</code></li>
              <li>Use the reasoning model: <code class="text-blue-400 bg-blue-400/10 px-1.5 py-0.5 rounded font-mono text-xs ml-1">ass -t "Explain quantum physics"</code></li>
            </ol>
          </div>
        </div>
      </section>

      {user.role === 'admin' && (
        <>
          <!-- USERS TAB -->
          <section id="users" class="tab-content hidden animate-in fade-in duration-500">
            <div class="mb-8">
              <h1 class="text-3xl font-bold uppercase tracking-widest mb-2">Users</h1>
              <div class="text-sm opacity-60">Manage API access and expirations.</div>
            </div>

            <div class="card overflow-hidden border border-[var(--border)] shadow-xl">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b border-[var(--border)] bg-white/5">
                    <th class="p-4 text-xs uppercase tracking-widest opacity-60 font-semibold">User</th>
                    <th class="p-4 text-xs uppercase tracking-widest opacity-60 font-semibold">Role</th>
                    <th class="p-4 text-xs uppercase tracking-widest opacity-60 font-semibold hidden md:table-cell">Expires At</th>
                    <th class="p-4 text-xs uppercase tracking-widest opacity-60 font-semibold text-right">Actions</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[var(--border)]">
                  {users.map((u: any) => (
                    <tr class="hover:bg-white/5 transition-colors">
                      <td class="p-4 text-sm font-mono">{u.username}</td>
                      <td class="p-4 text-sm">
                        <span class={`inline-block px-2 py-1 rounded text-[10px] uppercase tracking-widest ${u.role === 'admin' ? 'bg-blue-500/20 text-blue-400 border border-blue-500/30' : 'bg-white/10 border border-white/10'}`}>
                          {u.role}
                        </span>
                      </td>
                      <td class="p-4 text-sm font-mono opacity-80 hidden md:table-cell">
                        {u.expires_at ? new Date(u.expires_at).toLocaleString() : 'Never'}
                      </td>
                      <td class="p-4 text-right space-x-2 whitespace-nowrap">
                        {u.role !== 'admin' && (
                          <>
                            <button class="btn-ghost !text-xs extend-btn hover:bg-white/10" data-id={u.id}>+1 Day</button>
                            <button class="btn-danger !text-xs delete-btn" data-id={u.id}>Revoke</button>
                          </>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <!-- REQUESTS TAB -->
          <section id="requests" class="tab-content hidden animate-in fade-in duration-500">
            <div class="mb-8">
              <h1 class="text-3xl font-bold uppercase tracking-widest mb-2">Access Requests</h1>
              <div class="text-sm opacity-60">Review and approve new API users.</div>
            </div>

            <div class="card overflow-hidden border border-[var(--border)] shadow-xl">
              {requests.length === 0 ? (
                <div class="p-16 text-center opacity-60 text-sm uppercase tracking-widest flex flex-col items-center gap-4">
                  <svg class="w-12 h-12 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  No pending requests
                </div>
              ) : (
                <table class="w-full text-left border-collapse">
                  <thead>
                    <tr class="border-b border-[var(--border)] bg-white/5">
                      <th class="p-4 text-xs uppercase tracking-widest opacity-60 font-semibold">User</th>
                      <th class="p-4 text-xs uppercase tracking-widest opacity-60 font-semibold hidden sm:table-cell">Status</th>
                      <th class="p-4 text-xs uppercase tracking-widest opacity-60 font-semibold hidden md:table-cell">Requested At</th>
                      <th class="p-4 text-xs uppercase tracking-widest opacity-60 font-semibold text-right">Actions</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-[var(--border)]">
                    {requests.map((req: any) => (
                      <tr class="hover:bg-white/5 transition-colors">
                        <td class="p-4 text-sm font-mono">
                          {req.username}
                          <div class="sm:hidden mt-1">
                            <span class={`inline-block px-2 py-0.5 rounded text-[9px] uppercase tracking-widest ${req.status === 'approved' ? 'bg-green-500/20 text-green-400 border border-green-500/30' : 'bg-yellow-500/20 text-yellow-400 border border-yellow-500/30'}`}>
                              {req.status}
                            </span>
                          </div>
                        </td>
                        <td class="p-4 text-sm hidden sm:table-cell">
                          <span class={`inline-block px-2 py-1 rounded text-[10px] uppercase tracking-widest ${req.status === 'approved' ? 'bg-green-500/20 text-green-400 border border-green-500/30' : 'bg-yellow-500/20 text-yellow-400 border border-yellow-500/30'}`}>
                            {req.status}
                          </span>
                        </td>
                        <td class="p-4 text-sm opacity-80 hidden md:table-cell">{new Date(req.requested_at).toLocaleString()}</td>
                        <td class="p-4 text-right space-x-2 whitespace-nowrap">
                          {req.status === 'pending' && (
                            <button class="btn-ghost !text-green-400 !border !border-green-500/30 hover:!bg-green-500/10 approve-btn !text-xs" data-id={req.id}>Approve</button>
                          )}
                          <button class="btn-danger reject-btn !text-xs" data-id={req.id}>Delete</button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
            </div>
          </section>

          <!-- SETTINGS TAB -->
          <section id="settings" class="tab-content hidden animate-in fade-in duration-500 max-w-2xl">
            <div class="mb-8">
              <h1 class="text-3xl font-bold uppercase tracking-widest mb-2">Settings</h1>
              <div class="text-sm opacity-60">System configuration and defaults.</div>
            </div>

            <div class="card p-8 border border-[var(--border)] shadow-xl">
              <form id="settings-form" class="space-y-8">
                <div class="flex items-center justify-between border-b border-[var(--border)] pb-8">
                  <div>
                    <div class="font-bold uppercase tracking-widest mb-2 text-sm">API Status</div>
                    <div class="text-xs opacity-60 leading-relaxed max-w-xs">Allow users to query the AI model via the CLI. If disabled, all requests will be rejected.</div>
                  </div>
                  <label class="relative inline-flex items-center cursor-pointer ml-4">
                    <input type="checkbox" id="api-enabled" class="sr-only peer" checked={apiEnabled}>
                    <div class="w-14 h-7 bg-[rgba(242,242,242,0.2)] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-blue-500 shadow-inner"></div>
                  </label>
                </div>

                <div>
                  <label for="default-exp" class="block text-sm mb-3 uppercase tracking-wider font-semibold opacity-90">Default Expiration (Days)</label>
                  <input type="number" id="default-exp" name="default-exp" class="field w-full max-w-[200px] text-lg px-4 py-3 bg-black/40" value={defaultExp} min="1" max="365" />
                  <p class="text-xs opacity-50 mt-3 max-w-sm leading-relaxed">The number of days a user has access to the API after an admin approves their request.</p>
                </div>

                <div class="pt-4">
                  <button type="submit" class="btn-primary w-full sm:w-auto px-8 py-3">Save Configuration</button>
                </div>
              </form>
            </div>
          </section>
        </>
      )}
    </div>
  </div>
  
  <script>
    import { customAlert, customConfirm } from '../lib/ui';

    // Tab Switching Logic
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = (e.currentTarget as HTMLButtonElement).dataset.target;

        // Reset all buttons
        tabBtns.forEach(b => {
          b.classList.remove('bg-[var(--border)]', 'text-white');
          b.classList.add('text-white/60', 'hover:text-white', 'hover:bg-white/5');
        });
        // Hide all content
        tabContents.forEach(c => {
          c.classList.add('hidden');
          c.classList.remove('block');
        });

        // Activate clicked button
        const curr = e.currentTarget as HTMLButtonElement;
        curr.classList.remove('text-white/60', 'hover:text-white', 'hover:bg-white/5');
        curr.classList.add('bg-[var(--border)]', 'text-white');

        // Show target content
        const targetSection = document.getElementById(target!);
        if (targetSection) {
          targetSection.classList.remove('hidden');
          targetSection.classList.add('block');
        }
      });
    });

    // Admin Actions
    const settingsForm = document.getElementById('settings-form');
    if (settingsForm) {
      settingsForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const apiEnabled = (document.getElementById('api-enabled') as HTMLInputElement).checked;
        const defaultExp = (document.getElementById('default-exp') as HTMLInputElement).value;
        
        await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ api_enabled: apiEnabled.toString(), default_expiration_days: defaultExp })
        });
        await customAlert('Settings saved successfully.');
      });
    }

    document.querySelectorAll('.extend-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLButtonElement).dataset.id;
        const res = await fetch(`/api/users/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'extend', days: 1 })
        });
        if (res.ok) window.location.reload();
      });
    });

    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (!(await customConfirm('Are you sure you want to revoke access for this user?'))) return;
        const id = (e.currentTarget as HTMLButtonElement).dataset.id;
        const res = await fetch(`/api/users/${id}`, { method: 'DELETE' });
        if (res.ok) window.location.reload();
      });
    });

    document.querySelectorAll('.approve-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLButtonElement).dataset.id;
        const res = await fetch(`/api/access-requests/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'approve' })
        });
        if (res.ok) window.location.reload();
      });
    });

    document.querySelectorAll('.reject-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (!(await customConfirm('Are you sure you want to delete this request?'))) return;
        const id = (e.currentTarget as HTMLButtonElement).dataset.id;
        const res = await fetch(`/api/access-requests/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'reject' })
        });
        if (res.ok) window.location.reload();
      });
    });
  </script>
</DashboardLayout>
