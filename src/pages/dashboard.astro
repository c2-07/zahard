---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { sql, getSetting } from '../lib/db';
import { verifySession } from '../lib/auth';

const cookie = Astro.cookies.get('session');
if (!cookie) {
  return Astro.redirect('/login');
}
const user = await verifySession(cookie.value);
if (!user) {
  return Astro.redirect('/login');
}

const host = Astro.url.host;
const protocol = Astro.url.protocol;
const installUrl = `${protocol}//${host}/install`;

let apiEnabled = false;
let defaultExp = 1;
let userExpiresAt = null;
let users: any[] = [];
let requests: any[] = [];
let pendingCount = 0;

function formatRemainingTime(expiresAt: string | Date | null | undefined): string {
  if (!expiresAt) return 'Never';
  const target = new Date(expiresAt).getTime();
  if (isNaN(target)) return 'Never';
  const now = Date.now();
  const diffMs = target - now;

  if (diffMs <= 0) return 'Expired';

  const diffSecs = Math.floor(diffMs / 1000);
  const diffMins = Math.floor(diffSecs / 60);
  const diffHours = Math.floor(diffMins / 60);
  const diffDays = Math.floor(diffHours / 24);
  const diffMonths = Math.floor(diffDays / 30);

  if (diffMonths >= 1) {
    const remDays = diffDays % 30;
    if (diffMonths === 1) {
      return remDays > 0 ? `1 month, ${remDays}d` : `1 month`;
    }
    return remDays > 0 ? `${diffMonths} months, ${remDays}d` : `${diffMonths} months`;
  }
  if (diffDays >= 2) {
    return `${diffDays} days`;
  }
  if (diffDays === 1) {
    const remHours = diffHours % 24;
    return remHours > 0 ? `1 day, ${remHours}h` : `1 day`;
  }
  if (diffHours >= 1) {
    const remMins = diffMins % 60;
    return remMins > 0 ? `${diffHours}h, ${remMins}m` : `${diffHours} hours`;
  }
  return `${Math.max(1, diffMins)} mins`;
}

if (user?.role === 'admin') {
  if (user.userId === 'guest') {
    apiEnabled = true;
    defaultExp = 7;
    users = [
      { 
        id: 'mock1', 
        username: 'alice.student', 
        role: 'user', 
        created_at: new Date().toISOString(), 
        expires_at: new Date(Date.now() + 86400000 * 5).toISOString(),
        api_calls: 14,
        daily_calls_today: 14,
        last_used_time: new Date(Date.now() - 1000 * 60 * 12).toLocaleString(),
        last_used_location: 'New York, US',
        sessions: [
          { ip: '192.168.1.102', location: 'New York, US', device: 'za CLI (macOS)', last_active: new Date(Date.now() - 1000 * 60 * 12).toISOString() }
        ]
      },
      { 
        id: 'mock2', 
        username: 'bob.test', 
        role: 'user', 
        created_at: new Date().toISOString(), 
        expires_at: null,
        api_calls: 3,
        daily_calls_today: 3,
        last_used_time: new Date(Date.now() - 1000 * 3600 * 3).toLocaleString(),
        last_used_location: 'London, GB',
        sessions: [
          { ip: '10.0.0.45', location: 'London, GB', device: 'za CLI (Linux)', last_active: new Date(Date.now() - 1000 * 3600 * 3).toISOString() }
        ]
      }
    ];
    requests = [
      { id: 'req1', username: 'charlie.new', status: 'pending', requested_at: new Date().toISOString() },
      { id: 'req2', username: 'diana.demo', status: 'approved', requested_at: new Date(Date.now() - 3600000).toISOString() }
    ];
    pendingCount = 1;
  } else {
    apiEnabled = await getSetting('api_enabled') === 'true';
    defaultExp = parseInt(await getSetting('default_expiration_days') || '1');
    
    const { rows: uRows } = await sql`SELECT * FROM users ORDER BY created_at DESC`;
    users = uRows;
    
    const today = new Date().toISOString().slice(0, 10);
    const { rows: sessions } = await sql`SELECT * FROM user_sessions ORDER BY last_active DESC`;
    users.forEach((u: any) => {
      u.daily_calls_today = u.last_call_date === today ? (u.daily_calls || 0) : 0;
      const allUserSessions = sessions.filter(s => s.user_id === u.id);

      // Deduplicate: Don't show same IP twice for the same device
      const seen = new Set<string>();
      const uniqueSessions: typeof allUserSessions = [];
      for (const s of allUserSessions) {
        const key = `${s.device || 'unknown'}-${s.ip || 'unknown'}`;
        if (!seen.has(key)) {
          seen.add(key);
          uniqueSessions.push(s);
        }
      }
      u.sessions = uniqueSessions;

      // Last time za was used and where
      const latest = allUserSessions[0];
      if (latest && latest.last_active) {
        u.last_used_time = new Date(latest.last_active).toLocaleString();
        u.last_used_location = (latest.location && latest.location !== 'Unknown, Unknown') ? latest.location : (latest.ip || 'Unknown location');
      } else {
        u.last_used_time = null;
        u.last_used_location = null;
      }
    });
    
    const { rows: rRows } = await sql`SELECT * FROM access_requests ORDER BY requested_at DESC`;
    requests = rRows;
    pendingCount = requests.filter((r: any) => r.status === 'pending').length;
  }
} else {
  const { rows } = await sql`SELECT expires_at FROM users WHERE id = ${user?.userId}`;
  userExpiresAt = rows[0]?.expires_at;
}
---
<DashboardLayout title="Dashboard">
  <div class="flex flex-col md:flex-row gap-8 flex-1">
    <!-- Navigation Tabs (Sticky sidebar that docks cleanly below header on desktop & mobile) -->
    <aside class="w-full md:w-56 shrink-0 flex flex-row md:flex-col gap-2 overflow-x-auto md:overflow-visible scrollbar-hide sticky top-[73px] md:top-24 md:self-start z-30 bg-[#000000] md:bg-transparent pt-1 pb-3 -mx-6 px-6 md:p-0 md:m-0 border-b md:border-b-0 border-[var(--border)] md:border-transparent">
      <button class="tab-btn active shrink-0 md:shrink md:w-full text-left px-4 py-2 text-xs font-semibold tracking-[0.12em] uppercase transition-all whitespace-nowrap" data-target="overview">
        Overview
      </button>
      
      {user.role === 'admin' && (
        <>
          <button class="tab-btn shrink-0 md:shrink md:w-full text-left px-4 py-2 text-xs font-semibold tracking-[0.12em] uppercase transition-all flex justify-between items-center opacity-60 hover:opacity-100 hover:bg-[rgba(242,242,242,0.05)] whitespace-nowrap" data-target="users">
            Users
          </button>
          <button class="tab-btn shrink-0 md:shrink md:w-full text-left px-4 py-2 text-xs font-semibold tracking-[0.12em] uppercase transition-all flex justify-between items-center opacity-60 hover:opacity-100 hover:bg-[rgba(242,242,242,0.05)] whitespace-nowrap" data-target="requests">
            Requests
            <span id="pending-count-badge" class={`bg-[var(--paper)] text-[var(--black)] px-1.5 py-0.5 ml-2 font-mono ${pendingCount > 0 ? '' : 'hidden'}`}>{pendingCount}</span>
          </button>
          <button class="tab-btn shrink-0 md:shrink md:w-full text-left px-4 py-2 text-xs font-semibold tracking-[0.12em] uppercase transition-all opacity-60 hover:opacity-100 hover:bg-[rgba(242,242,242,0.05)] whitespace-nowrap" data-target="settings">
            Settings
          </button>
        </>
      )}
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 min-w-0">
      
      <!-- OVERVIEW TAB -->
      <section id="overview" class="tab-content block">
        <div class="mb-8">
          <h1 class="text-3xl font-bold uppercase tracking-widest mb-2">Welcome, {user.username}</h1>
          <div class="text-sm opacity-60">Your workspace is ready.</div>
        </div>

        {user.role === 'user' && (
          <div class="text-sm p-4 mb-6 bg-[rgba(242,242,242,0.05)] border border-[var(--border)] flex items-center justify-between">
            <div>
              <span class="opacity-60 uppercase tracking-widest text-[10px] block mb-0.5">Account Status</span>
              <span class="font-mono text-sm font-semibold text-[var(--paper)]">
                {userExpiresAt ? `Access remaining: ${formatRemainingTime(userExpiresAt)}` : 'Permanent Access'}
              </span>
            </div>
            <span class={`inline-block px-2.5 py-1 text-[10px] uppercase tracking-wider font-mono font-semibold ${formatRemainingTime(userExpiresAt) === 'Expired' ? 'bg-red-500/20 text-red-400 border border-red-500/40' : 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40'}`}>
              {formatRemainingTime(userExpiresAt) === 'Expired' ? 'Expired' : 'Active'}
            </span>
          </div>
        )}

        <!-- Install Instructions -->
        <div class="card p-6 mb-8">
          <h2 class="text-xl font-bold uppercase tracking-wider mb-4">CLI Installation</h2>
          <p class="mb-4 text-sm opacity-80">Run the command for your operating system to install the `za` CLI locally:</p>

          <div class="space-y-4 mb-6">
            <div class="text-[10px] uppercase tracking-widest opacity-60">macOS / Linux</div>
            <div class="border border-[var(--border)] bg-[#000000] relative group rounded-sm flex items-center">
              <div class="p-3 sm:p-4 pr-20 font-mono text-xs sm:text-sm text-[var(--paper)] overflow-x-auto whitespace-pre w-full scrollbar-hide">
                <code>curl -fsSL {installUrl} | bash</code>
              </div>
              <div class="absolute right-2">
                <button type="button" class="btn-ghost !px-3 !py-1.5 !text-[10px] opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity focus:opacity-100 copy-btn" data-command={`curl -fsSL ${installUrl} | bash`}>
                  Copy
                </button>
              </div>
            </div>

            <div class="text-[10px] uppercase tracking-widest opacity-60">Windows (PowerShell)</div>
            <div class="border border-[var(--border)] bg-[#000000] relative group rounded-sm flex items-center">
              <div class="p-3 sm:p-4 pr-20 font-mono text-xs sm:text-sm text-[var(--paper)] overflow-x-auto whitespace-pre w-full scrollbar-hide">
                <code>irm {installUrl} | iex</code>
              </div>
              <div class="absolute right-2">
                <button type="button" class="btn-ghost !px-3 !py-1.5 !text-[10px] opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity focus:opacity-100 copy-btn" data-command={`irm ${installUrl} | iex`}>
                  Copy
                </button>
              </div>
            </div>
          </div>
          
          <div class="text-sm opacity-80 mt-6">
            <div class="font-bold uppercase tracking-widest text-xs mb-3 opacity-60">Next Steps:</div>
            <ol class="list-decimal list-inside space-y-3">
              <li>Log in to your account: <code class="font-mono bg-[rgba(242,242,242,0.1)] px-1.5 py-0.5 rounded ml-1 text-[var(--paper)]"><span class="font-bold">za</span> login</code></li>
              <li>Ask a question: <code class="font-mono bg-[rgba(242,242,242,0.1)] px-1.5 py-0.5 rounded ml-1 text-[var(--paper)]"><span class="font-bold">za</span> <span class="opacity-80 underline underline-offset-4">"Hello world!"</span></code></li>
              <li>Use reasoning: <code class="font-mono bg-[rgba(242,242,242,0.1)] px-1.5 py-0.5 rounded ml-1 text-[var(--paper)]"><span class="font-bold">za</span> <span class="opacity-60">-t</span> <span class="opacity-80 underline underline-offset-4">"Explain quantum physics"</span></code></li>
            </ol>
          </div>
        </div>

        <!-- PIPING WORKFLOWS -->
        <div class="card p-6 mb-8">
          <div class="flex items-center gap-2 mb-2">
            <span class="font-mono text-emerald-400 text-lg font-bold">|</span>
            <h2 class="text-xl font-bold uppercase tracking-wider">How to Pipe into `za`</h2>
          </div>
          <p class="mb-6 text-sm opacity-80">
            Piping lets you pass code files, compiler errors, or git diffs directly into the CLI without manual copy-pasting:
          </p>

          <div class="space-y-4">
            <!-- 1. Debug code -->
            <div class="border border-[var(--border)] bg-[#000000] p-4 rounded-sm">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs uppercase font-semibold tracking-wider text-[var(--paper)]">1. Debug Source Code</span>
                <button type="button" class="btn-ghost !px-2.5 !py-1 !text-[10px] copy-btn" data-command='cat solution.c | za "find memory leaks or bugs"'>Copy</button>
              </div>
              <div class="font-mono text-xs text-[var(--paper)] opacity-90 overflow-x-auto whitespace-pre scrollbar-hide">
                <code>cat solution.c | za "find memory leaks or bugs"</code>
              </div>
              <div class="text-[11px] opacity-50 mt-1">Sends the entire file along with your prompt as context.</div>
            </div>

            <!-- 2. Fix compiler errors -->
            <div class="border border-[var(--border)] bg-[#000000] p-4 rounded-sm">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs uppercase font-semibold tracking-wider text-[var(--paper)]">2. Fix Compiler Warnings & Errors</span>
                <button type="button" class="btn-ghost !px-2.5 !py-1 !text-[10px] copy-btn" data-command='gcc main.c 2>&1 | za "explain this error and how to fix it"'>Copy</button>
              </div>
              <div class="font-mono text-xs text-[var(--paper)] opacity-90 overflow-x-auto whitespace-pre scrollbar-hide">
                <code>gcc main.c 2>&1 | za "explain this error and how to fix it"</code>
              </div>
              <div class="text-[11px] opacity-50 mt-1">Pipes stderr compiler logs straight into the AI for an immediate diagnosis.</div>
            </div>

            <!-- 3. Fix and save directly to clean file -->
            <div class="border border-[var(--border)] bg-[#000000] p-4 rounded-sm">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs uppercase font-semibold tracking-wider text-[var(--paper)]">3. Fix & Save Directly to Clean File (-o)</span>
                <button type="button" class="btn-ghost !px-2.5 !py-1 !text-[10px] copy-btn" data-command='cat buggy.c | za -o fixed.c "fix all syntax and logic errors"'>Copy</button>
              </div>
              <div class="font-mono text-xs text-[var(--paper)] opacity-90 overflow-x-auto whitespace-pre scrollbar-hide">
                <code>cat buggy.c | za -o fixed.c "fix all syntax and logic errors"</code>
              </div>
              <div class="text-[11px] opacity-50 mt-1">Generates fixed code and saves it as pure UTF-8 directly to disk.</div>
            </div>

            <!-- 4. Review git diffs -->
            <div class="border border-[var(--border)] bg-[#000000] p-4 rounded-sm">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs uppercase font-semibold tracking-wider text-[var(--paper)]">4. Review Git Diff & Generate Commit Msg</span>
                <button type="button" class="btn-ghost !px-2.5 !py-1 !text-[10px] copy-btn" data-command='git diff | za "write a concise commit message for these changes"'>Copy</button>
              </div>
              <div class="font-mono text-xs text-[var(--paper)] opacity-90 overflow-x-auto whitespace-pre scrollbar-hide">
                <code>git diff | za "write a concise commit message for these changes"</code>
              </div>
              <div class="text-[11px] opacity-50 mt-1">Analyzes unstaged changes and crafts a clean conventional commit summary.</div>
            </div>

            <!-- 5. Prompt file pipe -->
            <div class="border border-[var(--border)] bg-[#000000] p-4 rounded-sm">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs uppercase font-semibold tracking-wider text-[var(--paper)]">5. Pipe Prompt File</span>
                <button type="button" class="btn-ghost !px-2.5 !py-1 !text-[10px] copy-btn" data-command="cat assignment.txt | za">Copy</button>
              </div>
              <div class="font-mono text-xs text-[var(--paper)] opacity-90 overflow-x-auto whitespace-pre scrollbar-hide">
                <code>cat assignment.txt | za</code>
              </div>
              <div class="text-[11px] opacity-50 mt-1">Executes the file contents directly as the prompt.</div>
            </div>
          </div>
        </div>

        <!-- TROUBLESHOOTING & FAQS -->
        <div class="card p-6 mb-8">
          <h2 class="text-xl font-bold uppercase tracking-wider mb-2">Troubleshooting & FAQs</h2>
          <p class="mb-6 text-sm opacity-80">Quick fixes for common errors in lab and terminal environments:</p>

          <div class="space-y-4">
            <!-- FAQ 1: command not found -->
            <div class="border border-[var(--border)] p-4 bg-[#050505] rounded-sm">
              <div class="flex items-center gap-2 mb-2 font-mono text-xs font-bold text-red-400">
                <span class="text-red-500 font-bold">✕</span> Error: command not found: za
              </div>
              <div class="text-xs opacity-80 space-y-2">
                <div>Your current shell session has not loaded the new PATH entry yet. Run:</div>
                <div class="font-mono text-[11px] bg-[#000000] p-2.5 border border-[var(--border)] text-[var(--paper)] space-y-1">
                  <div><span class="text-blue-400 font-semibold">Linux:</span> source ~/.bashrc</div>
                  <div><span class="text-blue-400 font-semibold">macOS:</span> source ~/.zshrc</div>
                  <div><span class="text-blue-400 font-semibold">Windows:</span> Restart PowerShell (or close and reopen terminal)</div>
                </div>
              </div>
            </div>

            <!-- FAQ 2: null character / stray \377 -->
            <div class="border border-[var(--border)] p-4 bg-[#050505] rounded-sm">
              <div class="flex items-center gap-2 mb-2 font-mono text-xs font-bold text-amber-400">
                <span class="text-amber-500 font-bold">⚠</span> GCC Warning: null character(s) ignored or stray '\377'
              </div>
              <div class="text-xs opacity-80 space-y-2">
                <div>In Windows PowerShell, shell redirection (<code class="font-mono bg-[rgba(242,242,242,0.1)] px-1">&gt; file.c</code>) encodes files in UTF-16 with null bytes. Always use the built-in <code class="font-mono bg-[rgba(242,242,242,0.1)] px-1 text-[var(--paper)]">-o</code> flag instead:</div>
                <div class="font-mono text-[11px] bg-[#000000] p-2.5 border border-[var(--border)] text-[var(--paper)]">
                  za -o hello.c "write hello world in c"
                </div>
                <div class="text-[11px] opacity-60">This bypasses shell redirection and writes pure, clean UTF-8 directly to disk.</div>
              </div>
            </div>

            <!-- FAQ 3: Rate limit 100/day -->
            <div class="border border-[var(--border)] p-4 bg-[#050505] rounded-sm">
              <div class="flex items-center gap-2 mb-2 font-mono text-xs font-bold text-[var(--paper)]">
                <span class="text-emerald-400 font-bold">ℹ</span> Rate limit reached (100 requests/day)
              </div>
              <div class="text-xs opacity-80 space-y-1">
                <div>Student accounts have a fair-use quota of <strong>100 requests per day</strong> to prevent runaway loops. Quotas reset automatically every night at <strong>midnight UTC</strong>.</div>
              </div>
            </div>

            <!-- FAQ 4: Account expired -->
            <div class="border border-[var(--border)] p-4 bg-[#050505] rounded-sm">
              <div class="flex items-center gap-2 mb-2 font-mono text-xs font-bold text-red-400">
                <span class="text-red-500 font-bold">✕</span> Error: Account expired or Unauthorized
              </div>
              <div class="text-xs opacity-80 space-y-1">
                <div>Your temporary lab access period has concluded. If your lab session is still ongoing, contact your lab administrator or instructor to extend your account duration.</div>
              </div>
            </div>

            <!-- FAQ 5: Reasoning mode -->
            <div class="border border-[var(--border)] p-4 bg-[#050505] rounded-sm">
              <div class="flex items-center gap-2 mb-2 font-mono text-xs font-bold text-[var(--paper)]">
                <span class="text-blue-400 font-bold">⚡</span> How to enable Deep Reasoning mode?
              </div>
              <div class="text-xs opacity-80 space-y-1">
                <div>Add the <code class="font-mono bg-[rgba(242,242,242,0.1)] px-1 text-[var(--paper)]">-t</code> or <code class="font-mono bg-[rgba(242,242,242,0.1)] px-1 text-[var(--paper)]">--thinking</code> flag to route your query through high-depth reasoning models:</div>
                <div class="font-mono text-[11px] bg-[#000000] p-2.5 border border-[var(--border)] text-[var(--paper)] mt-1">
                  za -t "Explain how graph cycle detection works using Tarjan's algorithm"
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {user.role === 'admin' && (
        <>
          <!-- USERS TAB -->
          <section id="users" class="tab-content hidden">
            <div class="mb-8">
              <h1 class="text-3xl font-bold uppercase tracking-widest mb-2">Users</h1>
              <div class="text-sm opacity-60">Manage API access and expirations.</div>
            </div>

            <!-- Search & Filters -->
            <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between mb-4">
              <div class="relative flex-1 max-w-sm">
                <input 
                  type="text" 
                  id="user-search-input" 
                  class="field !py-2 !text-xs w-full" 
                  placeholder="Filter by username..." 
                  autocomplete="off"
                />
              </div>
              <div class="flex items-center gap-1.5 bg-[#000000] border border-[var(--border)] p-1 rounded-sm text-xs">
                <button type="button" class="user-filter-btn px-2.5 py-1 text-[10px] font-semibold tracking-wider uppercase bg-[var(--paper)] text-[var(--black)] transition-all" data-filter="all">All</button>
                <button type="button" class="user-filter-btn px-2.5 py-1 text-[10px] font-semibold tracking-wider uppercase opacity-60 hover:opacity-100 transition-all" data-filter="active">Active</button>
                <button type="button" class="user-filter-btn px-2.5 py-1 text-[10px] font-semibold tracking-wider uppercase opacity-60 hover:opacity-100 transition-all" data-filter="expired">Expired</button>
              </div>
            </div>

            <div class="card overflow-hidden">
              <div class="overflow-auto scrollbar-hide">
              <table class="w-full text-left border-collapse min-w-[720px]">
                <thead>
                  <tr class="border-b border-[var(--border)] bg-[rgba(242,242,242,0.05)]">
                    <th class="p-3 sm:p-4 text-xs uppercase tracking-widest opacity-60 font-semibold whitespace-nowrap min-w-[140px]">User</th>
                    <th class="p-3 sm:p-4 text-xs uppercase tracking-widest opacity-60 font-semibold hidden sm:table-cell whitespace-nowrap w-24">Role</th>
                    <th class="p-3 sm:p-4 text-xs uppercase tracking-widest opacity-60 font-semibold hidden md:table-cell whitespace-nowrap min-w-[140px]">Expires In</th>
                    <th class="p-3 sm:p-4 text-xs uppercase tracking-widest opacity-60 font-semibold text-right whitespace-nowrap">Actions</th>
                  </tr>
                </thead>
                <tbody id="users-table-body">
                  {users.map((u: any) => (
                    <>
                      <tr 
                        class="border-b border-[var(--border)] last:border-0 hover:bg-[rgba(242,242,242,0.02)] transition-colors cursor-pointer user-row" 
                        data-id={u.id}
                        data-username={(u.username || '').toLowerCase()}
                        data-status={u.expires_at && new Date(u.expires_at).getTime() < Date.now() ? 'expired' : 'active'}
                      >
                       <td class="p-3 sm:p-4 text-xs sm:text-sm font-mono whitespace-nowrap font-medium text-[var(--paper)]">{u.username}</td>
                       <td class="p-3 sm:p-4 text-xs sm:text-sm hidden sm:table-cell whitespace-nowrap">
                         <span class={`inline-block px-2 py-1 text-[10px] uppercase tracking-widest ${u.role === 'admin' ? 'bg-[var(--paper)] text-[var(--black)]' : 'bg-[rgba(242,242,242,0.1)]'}`}>
                            {u.role}
                          </span>
                        </td>
                        <td class="p-3 sm:p-4 text-xs sm:text-sm font-mono whitespace-nowrap">
                          {formatRemainingTime(u.expires_at) === 'Expired' ? (
                            <span class="text-red-400 font-semibold">Expired</span>
                          ) : formatRemainingTime(u.expires_at) === 'Never' ? (
                            <span class="opacity-50">Never</span>
                          ) : (
                            <span class="text-[var(--paper)]">{formatRemainingTime(u.expires_at)}</span>
                          )}
                        </td>
                        <td class="p-4 text-right space-x-2 whitespace-nowrap">
                         <button class="btn-ghost !text-xs logout-all-btn" data-id={u.id}>Logout Everywhere</button>
                         {u.role !== 'admin' && (
                            <>
                              <button class="btn-ghost !text-xs reset-pw-btn" data-id={u.id} data-username={u.username}>Reset PW</button>
                              <button class="btn-ghost !text-xs extend-btn" data-id={u.id}>Extend...</button>
                              <button class="btn-danger !text-xs delete-btn" data-id={u.id}>Revoke</button>
                            </>
                          )}
                        </td>
                      </tr>
                      
                      {/* Expanded Details Row */}
                      <tr id={`details-${u.id}`} class="hidden bg-[rgba(242,242,242,0.01)] border-b border-[var(--border)]">
                        <td colspan="4" class="p-4 sm:p-6 text-sm">
                          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <!-- API Calls Till Now & Daily Limit -->
                            <div class="border border-[var(--border)] p-4 bg-[#050505] rounded-sm">
                              <div class="flex items-center justify-between mb-2">
                                <div class="text-[10px] uppercase tracking-widest opacity-60 font-semibold">API Requests</div>
                                {u.role !== 'admin' && (
                                  <span class="text-[10px] uppercase tracking-wider font-mono px-1.5 py-0.5 border border-[var(--border)] bg-[#000000] text-[var(--paper)]">
                                    Today: {u.daily_calls_today || 0} / 100
                                  </span>
                                )}
                              </div>
                              <div class="text-2xl font-mono text-[var(--paper)]">{u.api_calls || 0} <span class="text-xs opacity-60 ml-1">total calls</span></div>
                              {u.role !== 'admin' && (
                                <div class="w-full bg-[rgba(242,242,242,0.1)] h-1 mt-3 rounded-none overflow-hidden">
                                  <div 
                                    class="bg-[var(--paper)] h-full transition-all" 
                                    style={`width: ${Math.min(100, Math.round(((u.daily_calls_today || 0) / 100) * 100))}%`}
                                  ></div>
                                </div>
                              )}
                            </div>

                            <!-- Last Time za Was Used & Where -->
                            <div class="border border-[var(--border)] p-4 bg-[#050505] rounded-sm">
                              <div class="text-[10px] uppercase tracking-widest opacity-60 mb-2 font-semibold">Last Used Activity</div>
                              {u.last_used_time ? (
                                <div>
                                  <div class="text-sm font-mono text-[var(--paper)]">{u.last_used_time}</div>
                                  <div class="text-xs opacity-60 mt-1 flex items-center gap-1.5">
                                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                    <span>{u.last_used_location}</span>
                                  </div>
                                </div>
                              ) : (
                                <div class="text-xs opacity-60 italic">Never used yet</div>
                              )}
                            </div>

                            <!-- Logged In Devices (Deduplicated) -->
                            <div class="border border-[var(--border)] p-4 bg-[#050505] rounded-sm md:col-span-1">
                              <div class="text-[10px] uppercase tracking-widest opacity-60 mb-2 font-semibold">Logged In Devices</div>
                              {(!u.sessions || u.sessions.length === 0) ? (
                                <div class="opacity-60 italic text-xs">No active devices</div>
                              ) : (
                                <div class="space-y-2 max-h-48 overflow-y-auto scrollbar-hide">
                                  {u.sessions.map((s: any) => (
                                    <div class="text-xs p-2.5 border border-[var(--border)] bg-[#000000] rounded-sm">
                                      <div class="flex items-center justify-between mb-1">
                                        <span class="font-mono text-[11px] text-[var(--paper)]">{s.ip}</span>
                                        <span class="text-[10px] opacity-40">{new Date(s.last_active).toLocaleDateString()}</span>
                                      </div>
                                      <div class="opacity-60 text-[11px] truncate mb-0.5" title={s.device}>{s.device || 'Unknown Device'}</div>
                                      <div class="opacity-40 text-[10px]">{s.location || 'Unknown Location'}</div>
                                    </div>
                                  ))}
                                </div>
                              )}
                            </div>
                          </div>
                        </td>
                      </tr>
                    </>
                  ))}
                </tbody>
              </table>
              </div>
            </div>
          </section>

          <!-- REQUESTS TAB -->
          <section id="requests" class="tab-content hidden">
            <div class="mb-8">
              <h1 class="text-3xl font-bold uppercase tracking-widest mb-2">Access Requests</h1>
              <div class="text-sm opacity-60">Review and approve new API users.</div>
            </div>

            <div class="card overflow-hidden">
              <div id="requests-empty" class={`p-6 text-center opacity-60 text-sm uppercase tracking-widest ${requests.length === 0 ? '' : 'hidden'}`}>No pending requests</div>
              <div id="requests-table-wrapper" class={`overflow-auto scrollbar-hide ${requests.length === 0 ? 'hidden' : ''}`}>
                <table class="w-full text-left border-collapse min-w-[640px]">
                  <thead>
                    <tr class="border-b border-[var(--border)] bg-[rgba(242,242,242,0.05)]">
                      <th class="p-3 sm:p-4 text-xs uppercase tracking-widest opacity-60 font-semibold whitespace-nowrap min-w-[140px]">User</th>
                      <th class="p-3 sm:p-4 text-xs uppercase tracking-widest opacity-60 font-semibold whitespace-nowrap w-24">Status</th>
                      <th class="p-3 sm:p-4 text-xs uppercase tracking-widest opacity-60 font-semibold hidden md:table-cell whitespace-nowrap min-w-[180px]">Requested At</th>
                      <th class="p-3 sm:p-4 text-xs uppercase tracking-widest opacity-60 font-semibold text-right whitespace-nowrap">Actions</th>
                    </tr>
                  </thead>
                  <tbody id="requests-body">
                    {requests.map((req: any) => (
                     <tr class="border-b border-[var(--border)] last:border-0 hover:bg-[rgba(242,242,242,0.02)] transition-colors" data-request-row-id={req.id}>
                       <td class="p-3 sm:p-4 text-xs sm:text-sm font-mono whitespace-nowrap font-medium text-[var(--paper)]">{req.username}</td>
                       <td class="p-3 sm:p-4 text-xs sm:text-sm whitespace-nowrap">
                          <span class={`inline-block px-2 py-1 text-[10px] uppercase tracking-widest ${req.status === 'approved' ? 'bg-[var(--paper)] text-[var(--black)]' : 'bg-[rgba(242,242,242,0.1)]'}`}>
                            {req.status}
                          </span>
                        </td>
                       <td class="p-3 sm:p-4 text-xs sm:text-sm opacity-80 hidden md:table-cell whitespace-nowrap">{new Date(req.requested_at).toLocaleString()}</td>
                       <td class="p-3 sm:p-4 text-right space-y-2 sm:space-y-0 sm:space-x-2 whitespace-nowrap">
                          {req.status === 'pending' && (
                           <button class="btn-success !text-xs approve-btn" data-id={req.id}>Approve</button>
                          )}
                          <button class="btn-danger !text-xs reject-btn" data-id={req.id}>Delete</button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          <!-- SETTINGS TAB -->
          <section id="settings" class="tab-content hidden">
            <div class="mb-8">
              <h1 class="text-3xl font-bold uppercase tracking-widest mb-2">Settings</h1>
              <div class="text-sm opacity-60">System configuration and defaults.</div>
            </div>

            <div class="card p-6 max-w-xl">
              <form id="settings-form" class="space-y-6">
                <div class="flex items-center justify-between border-b border-[var(--border)] pb-4">
                  <div>
                    <div class="font-bold uppercase tracking-widest mb-1 text-sm">API Status</div>
                    <div class="text-xs opacity-60">Allow users to query the AI model</div>
                  </div>
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="api-enabled" class="sr-only peer" checked={apiEnabled}>
                    <div class="w-11 h-6 bg-[rgba(242,242,242,0.2)] peer-focus:outline-none rounded-none peer peer-checked:after:translate-x-full peer-checked:after:border-[var(--black)] after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-[var(--paper)] after:border-[var(--border)] after:border after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--paper)]"></div>
                  </label>
                </div>

                <div>
                  <label for="default-exp" class="block text-sm mb-2 uppercase tracking-wider font-semibold opacity-80">Default Expiration</label>
                  <input type="number" id="default-exp" name="default-exp" class="field w-32" value={defaultExp} placeholder="Days" min="1" max="365" />
                </div>

                <div class="pt-2 flex justify-end">
                  <button type="submit" class="btn-primary">Save Settings</button>
                </div>
              </form>
            </div>

            <!-- CHANGE ADMIN PASSWORD -->
            <div class="card p-6 max-w-xl mt-8">
              <div class="font-bold uppercase tracking-widest mb-1 text-sm">Change Admin Password</div>
              <div class="text-xs opacity-60 mb-6">Update credentials for this administrator account.</div>

              <form id="change-password-form" class="space-y-4">
                <div id="pw-error-msg" class="hidden text-xs text-red-400 border border-red-500/40 bg-red-950/20 p-2.5 font-mono"></div>
                <div id="pw-success-msg" class="hidden text-xs text-emerald-400 border border-emerald-500/40 bg-emerald-950/20 p-2.5 font-mono"></div>

                <div>
                  <label for="current-password" class="block text-xs mb-1 uppercase tracking-wider font-semibold opacity-80">Current Password</label>
                  <input type="password" id="current-password" class="field w-full text-xs" required autocomplete="current-password" />
                </div>

                <div>
                  <label for="new-password" class="block text-xs mb-1 uppercase tracking-wider font-semibold opacity-80">New Password</label>
                  <input type="password" id="new-password" class="field w-full text-xs" required autocomplete="new-password" minlength="4" />
                </div>

                <div>
                  <label for="confirm-password" class="block text-xs mb-1 uppercase tracking-wider font-semibold opacity-80">Confirm New Password</label>
                  <input type="password" id="confirm-password" class="field w-full text-xs" required autocomplete="new-password" minlength="4" />
                </div>

                <div class="pt-2 flex justify-end">
                  <button type="submit" id="update-pw-btn" class="btn-primary !text-xs">Update Password</button>
                </div>
              </form>
            </div>

            <!-- DANGER ZONE -->
            <div id="danger-zone-card" class="card p-6 max-w-xl mt-8 border border-red-500/40 bg-red-950/10">
              <div class="flex items-center gap-2 mb-2 text-red-500 font-bold uppercase tracking-widest text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                Danger Zone
              </div>
              <div class="text-xs opacity-60 mb-6">
                Irreversible actions that affect all users across the system.
              </div>

              <div class="space-y-4">
                <!-- Logout Everyone -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border border-[var(--border)] p-4 bg-[#000000] rounded-sm">
                  <div>
                    <div class="font-bold text-xs uppercase tracking-wider text-[var(--paper)]">Logout Everyone At Once</div>
                    <div class="text-[11px] opacity-60">Immediately terminates all active sessions across all devices for all users.</div>
                  </div>
                  <button id="logout-everyone-btn" type="button" class="btn-danger !text-xs whitespace-nowrap shrink-0">
                    Logout Everyone
                  </button>
                </div>

                <!-- Delete Everyone's Account -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border border-red-500/30 p-4 bg-[#000000] rounded-sm">
                  <div>
                    <div class="font-bold text-xs uppercase tracking-wider text-red-400">Delete All User Accounts</div>
                    <div class="text-[11px] opacity-60">Permanently removes all user accounts and their history (preserves admin).</div>
                  </div>
                  <button id="delete-all-users-btn" type="button" class="btn-danger !bg-red-600 hover:!bg-red-700 !text-xs whitespace-nowrap shrink-0">
                    Delete All Accounts
                  </button>
                </div>
              </div>
            </div>
          </section>
        </>
      )}
    </div>
  </div>
  
  <style>
    /* Add explicit active state styling for tabs to keep HTML clean */
    .tab-btn.active {
      background-color: var(--paper);
      color: var(--black);
      opacity: 1;
    }
  </style>

  <script>
    import { customAlert, customConfirm, promptExpiration } from '../lib/ui';
    import { animate, stagger } from 'motion';

    // Page Load Animations
    animate('.tab-btn', { opacity: [0, 1], x: [-20, 0] }, { delay: stagger(0.05), duration: 0.4 });
    animate('.tab-content > *', { opacity: [0, 1], y: [20, 0] }, { delay: stagger(0.1, { startDelay: 0.2 }), duration: 0.5 });

    // Interactive Hover Effects for Cards and Rows
    const cards = document.querySelectorAll('.card');
    cards.forEach(card => {
      card.addEventListener('mouseenter', () => animate(card, { y: -2, boxShadow: '0 10px 25px -5px rgba(242, 242, 242, 0.1), 0 8px 10px -6px rgba(242, 242, 242, 0.1)' }, { duration: 0.2 }));
      card.addEventListener('mouseleave', () => animate(card, { y: 0, boxShadow: 'none' }, { duration: 0.2 }));
    });

    const rows = document.querySelectorAll('tbody tr');
    rows.forEach(row => {
      row.addEventListener('mouseenter', () => animate(row, { backgroundColor: 'rgba(242, 242, 242, 0.05)', scale: 1.01 }, { duration: 0.2 }));
      row.addEventListener('mouseleave', () => animate(row, { backgroundColor: 'transparent', scale: 1 }, { duration: 0.2 }));
    });

    // Tab Switching Logic
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    const switchTab = (target: string) => {
      tabBtns.forEach(b => {
        b.classList.remove('active');
        b.classList.add('opacity-60', 'hover:opacity-100', 'hover:bg-[rgba(242,242,242,0.05)]');
      });
      tabContents.forEach(c => {
        c.classList.add('hidden');
        c.classList.remove('block');
      });
      
      const btn = document.querySelector(`.tab-btn[data-target="${target}"]`);
      if (btn) {
        btn.classList.add('active');
        btn.classList.remove('opacity-60', 'hover:opacity-100', 'hover:bg-[rgba(242,242,242,0.05)]');
      }
      const targetSection = document.getElementById(target);
      if (targetSection) {
        targetSection.classList.remove('hidden');
        targetSection.classList.add('block');
      }
    };

    // Initialize tab from hash or default to overview without jump-scrolling
    const initialTab = window.location.hash ? window.location.hash.substring(1) : 'overview';
    switchTab(initialTab);

    tabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = (e.currentTarget as HTMLButtonElement).dataset.target;
        if (target) {
          history.replaceState(null, '', '#' + target);
          switchTab(target);
          window.scrollTo({ top: 0, behavior: 'instant' });
        }
      });
    });

    // Accordion Logic
    document.querySelectorAll('.user-row').forEach(row => {
      row.addEventListener('click', (e) => {
        // Prevent if clicking a button
        if ((e.target as HTMLElement).closest('button')) return;
        
        const id = (row as HTMLElement).dataset.id;
        const detailsRow = document.getElementById(`details-${id}`);
        if (detailsRow) {
          detailsRow.classList.toggle('hidden');
        }
      });
    });

    // Copy Button Logic
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const button = btn as HTMLButtonElement;
        const text = button.getAttribute('data-command');
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          const originalText = button.textContent;
          button.textContent = 'Copied!';
          setTimeout(() => { button.textContent = originalText; }, 2000);
        } catch (err) {
          console.error('Failed to copy', err);
        }
      });
    });

    // Admin Actions
    const settingsForm = document.getElementById('settings-form');
    if (settingsForm) {
      settingsForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const apiEnabled = (document.getElementById('api-enabled') as HTMLInputElement).checked;
        const defaultExp = (document.getElementById('default-exp') as HTMLInputElement).value;
        
        await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ api_enabled: apiEnabled.toString(), default_expiration_days: defaultExp })
        });
        await customAlert('Settings saved successfully.');
      });
    }

    const pendingBadge = document.getElementById('pending-count-badge');
    const requestsBody = document.getElementById('requests-body');
    const requestsEmpty = document.getElementById('requests-empty');
    const requestsTableWrapper = document.getElementById('requests-table-wrapper');

    const escapeHtml = (value: string) =>
      value
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');

    const updatePendingBadge = (count: number) => {
      if (!pendingBadge) return;
      pendingBadge.textContent = String(count);
      pendingBadge.classList.toggle('hidden', count === 0);
    };

    const renderRequests = (requests: any[]) => {
      if (!requestsBody || !requestsEmpty || !requestsTableWrapper) return;

      if (requests.length === 0) {
        requestsBody.innerHTML = '';
        requestsEmpty.classList.remove('hidden');
        requestsTableWrapper.classList.add('hidden');
        updatePendingBadge(0);
        return;
      }

      requestsEmpty.classList.add('hidden');
      requestsTableWrapper.classList.remove('hidden');

      requestsBody.innerHTML = requests.map((req) => `
        <tr class="border-b border-[var(--border)] last:border-0 hover:bg-[rgba(242,242,242,0.02)] transition-colors" data-request-row-id="${req.id}">
          <td class="p-3 sm:p-4 text-xs sm:text-sm font-mono whitespace-nowrap font-medium text-[var(--paper)]">${escapeHtml(req.username)}</td>
          <td class="p-3 sm:p-4 text-xs sm:text-sm whitespace-nowrap">
            <span class="inline-block px-2 py-1 text-[10px] uppercase tracking-widest ${req.status === 'approved' ? 'bg-[var(--paper)] text-[var(--black)]' : 'bg-[rgba(242,242,242,0.1)]'}">
              ${escapeHtml(req.status)}
            </span>
          </td>
          <td class="p-3 sm:p-4 text-xs sm:text-sm opacity-80 hidden md:table-cell whitespace-nowrap">${new Date(req.requested_at).toLocaleString()}</td>
          <td class="p-3 sm:p-4 text-right space-y-2 sm:space-y-0 sm:space-x-2 whitespace-nowrap">
            ${req.status === 'pending' ? `<button class="btn-success !text-xs approve-btn" data-id="${req.id}">Approve</button>` : ''}
            <button class="btn-danger !text-xs reject-btn" data-id="${req.id}">Delete</button>
          </td>
        </tr>
      `).join('');

      updatePendingBadge(requests.filter((req) => req.status === 'pending').length);
    };

    const refreshRequests = async () => {
      if (!requestsBody || !requestsEmpty || !requestsTableWrapper) return;
      try {
        const res = await fetch('/api/access-requests');
        if (!res.ok) return;
        const data = await res.json();
        renderRequests(Array.isArray(data) ? data : []);
      } catch {
        // ignore polling errors
      }
    };

    refreshRequests();
    setInterval(refreshRequests, 10000);

    document.addEventListener('click', async (event) => {
      const button = (event.target as HTMLElement).closest('button');
      if (!button) return;

      if (button.classList.contains('extend-btn')) {
        const id = (button as HTMLButtonElement).dataset.id;
        const result = await promptExpiration();
        if (!result) return;

        const payload: any = { action: 'extend' };
        payload[result.type] = result.value;

        const res = await fetch(`/api/users/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (res.ok) {
          await customAlert('User expiration updated.');
          window.location.hash = 'users';
          window.location.reload();
          return;
        }
        const errorText = await res.text();
        await customAlert(errorText || 'Failed to update user expiration.');
      }

      if (button.classList.contains('delete-btn')) {
        if (!(await customConfirm('Are you sure you want to revoke access for this user?'))) return;
        const id = (button as HTMLButtonElement).dataset.id;
        const res = await fetch(`/api/users/${id}`, { method: 'DELETE' });
        if (res.ok) {
          button.closest('tr')?.remove();
          await customAlert('User access revoked.');
          return;
        }
        const errorText = await res.text();
        await customAlert(errorText || 'Failed to revoke user access.');
      }

      if (button.classList.contains('approve-btn')) {
        const id = (button as HTMLButtonElement).dataset.id;
        const res = await fetch(`/api/access-requests/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'approve' })
        });
        if (res.ok) {
          await refreshRequests();
          return;
        }
        const errorText = await res.text();
        await customAlert(errorText || 'Failed to approve request.');
      }

      if (button.classList.contains('reject-btn')) {
        if (!(await customConfirm('Are you sure you want to delete this request?'))) return;
        const id = (button as HTMLButtonElement).dataset.id;
        const res = await fetch(`/api/access-requests/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'reject' })
        });
        if (res.ok) {
          await refreshRequests();
          return;
        }
        const errorText = await res.text();
        await customAlert(errorText || 'Failed to delete request.');
      }
      
      if (button.classList.contains('reset-pw-btn')) {
        const id = (button as HTMLButtonElement).dataset.id;
        const username = (button as HTMLButtonElement).dataset.username || 'this user';
        const newPassword = prompt(`Enter new password for ${username} (min 4 characters):`);
        if (!newPassword) return;
        if (newPassword.length < 4) {
          await customAlert('Password must be at least 4 characters long.');
          return;
        }
        try {
          const res = await fetch(`/api/users/${id}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'reset_password', newPassword })
          });
          if (res.ok) {
            await customAlert(`Password successfully updated for ${username}.`);
            return;
          }
          const err = await res.json().catch(() => ({}));
          await customAlert(err.error || 'Failed to reset password.');
        } catch {
          await customAlert('Network error occurred.');
        }
      }

      if (button.classList.contains('logout-all-btn')) {
        if (!(await customConfirm('Are you sure you want to log this user out of all devices?'))) return;
        const id = (button as HTMLButtonElement).dataset.id;
        const res = await fetch(`/api/users/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'logout_all' })
        });
        if (res.ok) {
          await customAlert('User logged out everywhere.');
          window.location.hash = 'users';
          window.location.reload();
          return;
        }
        const errorText = await res.text();
        await customAlert(errorText || 'Failed to logout user.');
      }
    });

    // Users Table Search & Filter
    const userSearchInput = document.getElementById('user-search-input') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll('.user-filter-btn');
    let currentFilter = 'all';

    function filterUsers() {
      const query = (userSearchInput?.value || '').toLowerCase().trim();
      const userRows = document.querySelectorAll<HTMLTableRowElement>('.user-row');

      userRows.forEach(row => {
        const username = row.dataset.username || '';
        const status = row.dataset.status || 'active';
        const id = row.dataset.id;
        const detailsRow = id ? document.getElementById(`details-${id}`) : null;

        const matchesQuery = !query || username.includes(query);
        const matchesFilter = currentFilter === 'all' || status === currentFilter;

        if (matchesQuery && matchesFilter) {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
          if (detailsRow) detailsRow.classList.add('hidden');
        }
      });
    }

    userSearchInput?.addEventListener('input', filterUsers);

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('bg-[var(--paper)]', 'text-[var(--black)]');
          b.classList.add('opacity-60');
        });
        btn.classList.add('bg-[var(--paper)]', 'text-[var(--black)]');
        btn.classList.remove('opacity-60');
        currentFilter = (btn as HTMLElement).dataset.filter || 'all';
        filterUsers();
      });
    });

    // Danger Zone: Logout Everyone
    document.getElementById('logout-everyone-btn')?.addEventListener('click', async () => {
      if (!(await customConfirm('WARNING: Are you sure you want to log out all users from all devices right now?'))) return;
      try {
        const res = await fetch('/api/admin/danger', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'logout_everyone' })
        });
        if (res.ok) {
          await customAlert('All users have been logged out of all devices.');
          window.location.reload();
          return;
        }
        const err = await res.text();
        await customAlert(err || 'Failed to logout everyone.');
      } catch {
        await customAlert('Network error occurred.');
      }
    });

    // Danger Zone: Delete All User Accounts
    document.getElementById('delete-all-users-btn')?.addEventListener('click', async () => {
      if (!(await customConfirm('CRITICAL: Are you sure you want to delete ALL user accounts? This action is permanent and cannot be undone.'))) return;
      if (!(await customConfirm('FINAL WARNING: This will immediately delete every non-admin user account and all their sessions. Proceed?'))) return;
      try {
        const res = await fetch('/api/admin/danger', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete_all_users' })
        });
        if (res.ok) {
          await customAlert('All user accounts have been deleted.');
          window.location.reload();
          return;
        }
        const err = await res.text();
        await customAlert(err || 'Failed to delete all users.');
      } catch {
        await customAlert('Network error occurred.');
      }
    });

    // Change Admin Password Form
    document.getElementById('change-password-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const currentPassword = (document.getElementById('current-password') as HTMLInputElement).value;
      const newPassword = (document.getElementById('new-password') as HTMLInputElement).value;
      const confirmPassword = (document.getElementById('confirm-password') as HTMLInputElement).value;
      const errorMsg = document.getElementById('pw-error-msg');
      const successMsg = document.getElementById('pw-success-msg');
      const submitBtn = document.getElementById('update-pw-btn') as HTMLButtonElement | null;

      errorMsg?.classList.add('hidden');
      successMsg?.classList.add('hidden');

      if (newPassword !== confirmPassword) {
        if (errorMsg) {
          errorMsg.textContent = 'New passwords do not match.';
          errorMsg.classList.remove('hidden');
        }
        return;
      }

      if (submitBtn) submitBtn.disabled = true;

      try {
        const res = await fetch('/api/auth/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ currentPassword, newPassword })
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          if (successMsg) {
            successMsg.textContent = data.message || 'Password successfully updated!';
            successMsg.classList.remove('hidden');
          }
          (document.getElementById('change-password-form') as HTMLFormElement)?.reset();
        } else {
          if (errorMsg) {
            errorMsg.textContent = data.error || 'Failed to update password.';
            errorMsg.classList.remove('hidden');
          }
        }
      } catch {
        if (errorMsg) {
          errorMsg.textContent = 'Network error occurred.';
          errorMsg.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  </script>
</DashboardLayout>
