---
import '../styles/global.css';
import { verifySession } from '../lib/auth';

const cookie = Astro.cookies.get('session');
let user = null;
if (cookie) {
  user = await verifySession(cookie.value);
}

if (!user) {
  return Astro.redirect('/login');
}

const { title } = Astro.props;
---
<html lang="en">
<head>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta charset="UTF-8">
  <title>{title} - Zahard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0000cc">
</head>
<body class="min-h-screen flex flex-col">
  <header class="border-b border-[var(--border)] bg-[rgba(0,0,242,0.8)] backdrop-blur-md sticky top-0 z-10 px-6 py-4 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <img src="/favicon.png" alt="Zahard Logo" class="h-10 w-10 object-contain" />
      <div class="font-bold uppercase tracking-widest text-lg">Zahard</div>
    </div>
    
    <div class="flex items-center gap-4">
      <div class="text-xs opacity-60 uppercase tracking-widest">
        {user.role}
      </div>
      <button id="logout-btn" class="btn-ghost !px-3 !py-1.5 text-xs">Logout</button>
    </div>
  </header>

  <main class="flex-1 p-6 pt-12 md:pt-16 max-w-6xl w-full mx-auto flex flex-col">
    <slot />
  </main>

  <script>
    import { animate } from 'motion';

    // Global Entrance Animations
    animate('header', { y: [-20, 0], opacity: [0, 1] }, { duration: 0.5, easing: 'ease-out' });
    animate('main', { y: [20, 0], opacity: [0, 1] }, { duration: 0.5, delay: 0.1, easing: 'ease-out' });

    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/login';
    });
  </script>
</body>
</html>
