---
import '../styles/global.css';
import { verifySession } from '../lib/auth';

const cookie = Astro.cookies.get('session');
let user = null;
if (cookie) {
  user = await verifySession(cookie.value);
}

if (!user) {
  return Astro.redirect('/login');
}

const { title } = Astro.props;
---
<html lang="en">
<head>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta charset="UTF-8">
  <title>{title} - Zahard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body class="min-h-screen flex flex-col bg-[var(--background)] text-[var(--foreground)] selection:bg-blue-500/30 selection:text-white">
  <header class="border-b border-[var(--border)] bg-black/40 backdrop-blur-xl sticky top-0 z-50 px-6 py-4 flex items-center justify-between shadow-sm">
    <div class="font-bold uppercase tracking-widest text-lg flex items-center gap-2">
      <div class="w-2 h-2 bg-blue-500 rounded-full animate-pulse shadow-[0_0_10px_rgba(59,130,246,0.8)]"></div>
      Zahard
    </div>
    
    <div class="flex items-center gap-4">
      <div class="text-[10px] font-mono opacity-80 uppercase tracking-widest bg-white/10 px-2 py-1 rounded border border-white/5">
        Role: {user.role}
      </div>
      <button id="logout-btn" class="btn-ghost !px-3 !py-1.5 text-xs hover:bg-white/10 transition-colors rounded">Logout</button>
    </div>
  </header>

  <main class="flex-1 w-full mx-auto flex flex-col p-4 md:p-8">
    <div class="flex-1 bg-black/20 border border-[var(--border)] rounded-2xl overflow-hidden shadow-2xl flex flex-col backdrop-blur-sm max-w-7xl mx-auto w-full">
      <slot />
    </div>
  </main>

  <script>
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/login';
    });
  </script>
</body>
</html>
